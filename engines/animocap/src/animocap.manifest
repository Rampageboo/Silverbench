<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Run the CLI with UTF-8 as its active code page. Its argv and every narrow
  std::string <-> std::filesystem::path conversion then carry Unicode paths
  (Chinese video and workspace names) intact instead of turning them into "?".
-->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
