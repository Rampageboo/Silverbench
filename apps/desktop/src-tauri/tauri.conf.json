{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YoloWorkBench",
  "version": "0.1.0",
  "identifier": "local.yoloworkbench.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:shell",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "YoloWorkBench",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "visible": false,
        "backgroundColor": "#0f172a"
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": []
  }
}
