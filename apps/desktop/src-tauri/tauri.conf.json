{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Silverbench",
  "version": "0.2.0",
  "identifier": "local.yoloworkbench.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:shell",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Silverbench",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "visible": false,
        "backgroundColor": "#0f172a"
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ1MTMzMjgzQkE3NThFQzAKUldUQWpuVzZneklUMWZxOVFuWXdnMGEwYjZIZmJYU2YyMVFQYzRuQnlYTU5YRDgzWjN6eWNFcTMK",
      "endpoints": [
        "https://github.com/Rampageboo/Silverbench/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
