{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YoloWorkBench",
  "version": "0.1.0",
  "identifier": "local.yoloworkbench.desktop",
  "build": {
    "beforeDevCommand": "npm run backend:dev",
    "devUrl": "http://127.0.0.1:8765",
    "beforeBuildCommand": "",
    "frontendDist": "../../../legacy/web"
  },
  "app": {
    "windows": [
      {
        "title": "YoloWorkBench",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
